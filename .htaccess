# Tat mod_pagespeed cua hosting - module nay tu dong toi uu/cache lai trang
# o phia may chu, TACH BIET voi cache trinh duyet va voi cache-bust ?v= cua
# website. Da phat hien no phuc vu ban CU cua trang (thieu logo Givaudan moi
# them) du file that tren server da cap nhat dung, va cache nay co the khac
# nhau giua www.quangthang.vn va quangthang.vn. Website da tu nen anh WebP
# va CSS/JS gon nhe nen loi ich cua mod_pagespeed khong dang de doi lay rui
# ro hien thi noi dung cu.
ModPagespeed off

# Ep toan bo truy cap chuyen sang HTTPS - neu khach vao bang http:// (go tay,
# link cu, bookmark cu...) se tu dong chuyen sang https:// thay vi tai trang
# qua ket noi khong ma hoa. Quan trong vi website co form lien he thu thap
# ten/email/so dien thoai khach hang.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bao ve trang admin.html bang HTTP Basic Auth (Apache kiem tra o may chu,
# khong the vuot qua bang cach sua JavaScript trong trinh duyet - day la
# lop bao mat THAT, khac voi lop kiem tra mat khau trong js/admin.js chi
# mang tinh tien dung).
#
# QUAN TRONG: file .htpasswd (chua mat khau da ma hoa) KHONG duoc dua len
# GitHub - phai tu tao va upload rieng qua File Manager/FTP, dat NGOAI
# thu muc public_html (vi du /home/quangthang/.htpasswd) de khong ai tai
# duoc truc tiep qua trinh duyet. Xem huong dan chi tiet o cuoi file nay.

<Files "admin.html">
  AuthType Basic
  AuthName "Khu vuc quan tri - Quang Thang Co.,LTD"
  AuthUserFile /home/quangthang/.htpasswd
  Require valid-user
</Files>

# Khong cho tai truc tiep bat ky file nao bat dau bang dau cham (.htaccess,
# .htpasswd neu lo dat nham trong public_html, .git...) - phong ho them.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Dung trang 404.html rieng cua website khi khach vao duong dan khong ton
# tai, thay vi trang loi mac dinh cua may chu (khong co logo/menu, trong
# thieu chuyen nghiep).
ErrorDocument 404 /404.html
